# Copia este archivo como .env y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). La clave publicable es pública por diseño: la seguridad
# la ponen las políticas RLS de supabase/migrations.
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
