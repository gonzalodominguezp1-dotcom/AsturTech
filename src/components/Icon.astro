---
import { icons, whatsappPath, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls = 'icon' } = Astro.props;
---
{name === 'whatsapp' ? (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={whatsappPath} />
) : (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[name]} />
)}
