---
/* Fondo animado: red de nodos conectados con "paquetes de datos" que viajan
   entre ellos y reaccionan al ratón / dedo. Se pausa fuera de pantalla y
   respeta "reducir movimiento" (se dibuja un único fotograma estático). */
---
<div class="tech-bg" aria-hidden="true">
  <div class="tech-aurora"></div>
  <canvas data-tech-bg></canvas>
</div>

<script>
  type Node = { x: number; y: number; vx: number; vy: number; r: number };
  type Pulse = { a: number; b: number; t: number; speed: number };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const LINK = 140;

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-tech-bg]').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const host = canvas.parentElement!.parentElement!;
    let w = 0, h = 0, dpr = 1, raf = 0, visible = true;
    let nodes: Node[] = [];
    let pulses: Pulse[] = [];
    const mouse = { x: -9999, y: -9999 };

    function resize() {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width; h = rect.height;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(90, Math.max(28, (w * h) / 11000)));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 1.6 + 0.8,
      }));
      pulses = [];
      draw();
    }

    function spawnPulse() {
      const a = Math.floor(Math.random() * nodes.length);
      let best = -1, bestD = LINK;
      for (let i = 0; i < nodes.length; i++) {
        if (i === a) continue;
        const d = Math.hypot(nodes[i].x - nodes[a].x, nodes[i].y - nodes[a].y);
        if (d < bestD && Math.random() > 0.3) { best = i; bestD = d; }
      }
      if (best >= 0) pulses.push({ a, b: best, t: 0, speed: 0.012 + Math.random() * 0.018 });
    }

    function step() {
      for (const n of nodes) {
        const dx = n.x - mouse.x, dy = n.y - mouse.y, d = Math.hypot(dx, dy);
        if (d < 120 && d > 0) { n.vx += (dx / d) * 0.03; n.vy += (dy / d) * 0.03; }
        n.vx *= 0.995; n.vy *= 0.995;
        const sp = Math.hypot(n.vx, n.vy);
        if (sp < 0.12) { n.vx += (Math.random() - 0.5) * 0.04; n.vy += (Math.random() - 0.5) * 0.04; }
        n.x += n.vx; n.y += n.vy;
        if (n.x < -20) n.x = w + 20; else if (n.x > w + 20) n.x = -20;
        if (n.y < -20) n.y = h + 20; else if (n.y > h + 20) n.y = -20;
      }
      if (pulses.length < 14 && Math.random() < 0.08) spawnPulse();
      pulses = pulses.filter((p) => (p.t += p.speed) < 1);
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < LINK) {
            ctx!.strokeStyle = `rgba(56, 189, 248, ${0.22 * (1 - d / LINK)})`;
            ctx!.lineWidth = 1;
            ctx!.beginPath(); ctx!.moveTo(a.x, a.y); ctx!.lineTo(b.x, b.y); ctx!.stroke();
          }
        }
      }
      for (const n of nodes) {
        const near = Math.hypot(n.x - mouse.x, n.y - mouse.y) < 160;
        ctx!.fillStyle = near ? 'rgba(45, 212, 191, 0.95)' : 'rgba(148, 197, 255, 0.6)';
        ctx!.beginPath(); ctx!.arc(n.x, n.y, near ? n.r + 0.8 : n.r, 0, Math.PI * 2); ctx!.fill();
      }
      for (const p of pulses) {
        const a = nodes[p.a], b = nodes[p.b];
        if (!a || !b) continue;
        const x = a.x + (b.x - a.x) * p.t, y = a.y + (b.y - a.y) * p.t;
        const g = ctx!.createRadialGradient(x, y, 0, x, y, 8);
        g.addColorStop(0, 'rgba(45, 212, 191, 0.9)'); g.addColorStop(1, 'rgba(45, 212, 191, 0)');
        ctx!.fillStyle = g; ctx!.beginPath(); ctx!.arc(x, y, 8, 0, Math.PI * 2); ctx!.fill();
      }
    }

    function loop() {
      if (!visible || document.hidden) { raf = 0; return; }
      step(); draw();
      raf = requestAnimationFrame(loop);
    }
    const start = () => { if (!reduce && !raf) raf = requestAnimationFrame(loop); };

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }).observe(host);
    document.addEventListener('visibilitychange', start);
    new ResizeObserver(resize).observe(canvas);

    host.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    }, { passive: true });
    host.addEventListener('pointerleave', () => { mouse.x = mouse.y = -9999; });

    resize();
    start();
  });
</script>
