---
import Icon from './Icon.astro';
import type { Feature } from '../data/services';

interface Props {
  items: Feature[];
}
const { items } = Astro.props;
---
<div class="grid grid-3">
  {items.map((f) => (
    <div class="card">
      <span class="card-icon"><Icon name={f.icon} /></span>
      <h3>{f.title}</h3>
      <p>{f.text}</p>
    </div>
  ))}
</div>
